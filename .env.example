# ---- Backend (app/) ---------------------------------------------------------
# Postgres in production (Railway injects this). Omit locally to use SQLite at ./data/patients.db
DATABASE_URL=postgresql://user:password@host:5432/patients
# Shared secret Vapi sends as the x-webhook-secret header. Generate: openssl rand -hex 24
VAPI_WEBHOOK_SECRET=change-me
# Optional: require X-API-Key on POST/PUT/DELETE /patients. Leave empty for open writes.
API_KEY=
SEED_DATA=true
CLINIC_NAME=Riverside Family Health
CLINIC_TIMEZONE=America/New_York
LOG_LEVEL=INFO
# Dashboard "call Ava" panel (browser-safe values only)
VAPI_PUBLIC_KEY=your-vapi-public-key
INTAKE_PHONE_NUMBER=+15555550100

# ---- Vapi provisioning (scripts/setup_vapi.py only) -------------------------
VAPI_API_KEY=your-vapi-private-key
# Public HTTPS URL of the deployed backend (Railway URL or ngrok tunnel)
PUBLIC_BASE_URL=https://your-app.up.railway.app
# Optional overrides
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_ID=EXAVITQu4vr4xnSDxMaL
VAPI_VOICE_MODEL=eleven_turbo_v2_5
VAPI_TRANSCRIBER_MODEL=nova-3
VAPI_TRANSCRIBER_LANGUAGE=multi
